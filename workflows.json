    "inspected_date": "2026-10-07",
    "evidence": "静态阅读此提交源码；请求是模板，不是真实抓包，也未实测登录或出声。"
  },
  "scope": {
    "included": "登录、Cookie、WBI、搜索/收藏夹/合集选歌、分 P、取音轨、空音轨回退和媒体读取。每个请求模板独立保存。",
    "excluded": "评论、点赞、歌词、UP 主空间浏览、一起听、广告跳过及下载管理等外围功能；WebView 页面内部请求源码不可见。"
  },
  "template_rules": [
    "{{name}} 是运行时变量，需按变量说明替换，不能直接发送占位符。",
    "query 中的数值采用源码字符串形式；headers 中标注 if_nonempty 的值为空时省略整个头。",
    "workflows.steps 是典型顺序，不是每项都无条件执行的脚本；每个请求的 condition 决定是否执行。",
    "WBI 请求自动先执行 ensure_wbi；首次调用可能出现匿名指纹/nav/ticket 子请求。",
    "参数和字段来自源码；未知响应内容不伪造，response.extract 记录读取路径。"
  ],
  "variables": {
    "qrcode_key": "qr_generate.data.qrcode_key",
    "qr_cookie_header_if_nonempty": "累计二维码请求响应 Set-Cookie，序列化 name=value; name=value",
    "stored_cookie_header": "保存的 Cookie Map，至少有非空 SESSDATA；不要提交真实值",
    "effective_cookie_header": "有任意保存 Cookie 则用保存值，否则用匿名 Cookie（缓存 1 小时）",
    "latest_stored_cookie_header_if_nonempty": "播放器订阅 cookieFlow 得到的最新保存 Cookie",
    "user_mid": "登录 Cookie DedeUserID，或显式 nav 登录检查的 data.mid；收藏夹接口的 up_mid",
    "keyword": "用户搜索词",
    "bvid": "搜索/收藏/合集/详情返回的 BV 号，或用户提供的 BV 号",
    "avid": "视频 AV 数字 ID；详情参数叫 aid，getPlayInfoByAvid 参数叫 avid",
    "cid": "选中的 pages 条目 cid，不是 aid/BV 号，也不是页码",
